{
  "name": "generation_smoke_random_cpu",
  "data": {
    "dataset": "random",
    "image_size": 16,
    "channels": 3,
    "batch_size": 2,
    "num_workers": 0,
    "class_conditional": true
  },
  "diffusion": {
    "num_train_timesteps": 16,
    "schedule_type": "cosine"
  },
  "model": {
    "image_channels": 3,
    "image_size": 16,
    "token_count": 4,
    "token_channels": 8,
    "base_channels": 16,
    "predictor_type": "scalable_unet",
    "predictor_channel_multipliers": [1, 2],
    "predictor_num_res_blocks": 1,
    "predictor_attention_resolutions": [8],
    "predictor_num_heads": 2,
    "num_classes": 10,
    "class_dropout_prob": 0.1,
    "synthesis_mode": "restricted",
    "synthesis_active_token_channels": [2, 4, 6, 8]
  },
  "loss": {
    "epsilon_weight": 1.0,
    "prefix_weight": 0.0,
    "monotonic_weight": 0.0,
    "zero_token_weight": 0.01,
    "denoise_path_prefix_weight": 0.05,
    "denoise_path_component_weight": 0.1
  },
  "runtime": {
    "seed": 17,
    "device": "cpu",
    "steps": 2,
    "precision": "fp32",
    "checkpoint_interval": 1,
    "evaluation_interval": 1,
    "keep_last_checkpoints": 2
  },
  "optimization": {
    "learning_rate": 0.0002,
    "warmup_steps": 0,
    "gradient_accumulation_steps": 2,
    "ema_decay": 0.99,
    "ema_warmup_steps": 1,
    "log_interval": 1
  }
}
