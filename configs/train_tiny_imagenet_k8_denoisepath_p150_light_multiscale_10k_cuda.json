{
  "name": "train_tiny_imagenet_k8_denoisepath_p150_light_multiscale_10k_cuda",
  "data": {
    "dataset": "tiny_imagenet_200",
    "root": "/root/autodl-tmp/CoFiTok/datasets",
    "image_size": 64,
    "channels": 3,
    "batch_size": 24,
    "num_workers": 2,
    "class_conditional": false
  },
  "model": {
    "image_channels": 3,
    "image_size": 64,
    "token_count": 8,
    "token_channels": 16,
    "base_channels": 48,
    "predictor_type": "multiscale_unet",
    "predictor_depth": 2,
    "predictor_multiscale_levels": 2,
    "synthesis_kernel_size": 3,
    "gamma_mode": "learned_scalar",
    "synthesis_active_token_channels": [4, 4, 8, 8, 12, 12, 16, 16]
  },
  "loss": {
    "epsilon_weight": 1.0,
    "prefix_weight": 0.0,
    "monotonic_weight": 0.0,
    "denoise_path_prefix_weight": 0.15,
    "denoise_path_component_weight": 0.3,
    "denoise_path_progress_power": 1.5
  },
  "runtime": {
    "device": "cuda",
    "seed": 151,
    "steps": 10000
  },
  "optimization": {
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "betas": [0.9, 0.999],
    "grad_clip_norm": 1.0,
    "log_interval": 1000,
    "visualization_count": 8
  }
}
