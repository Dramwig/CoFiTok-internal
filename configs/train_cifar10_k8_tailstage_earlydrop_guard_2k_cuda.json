{
  "name": "train_cifar10_k8_tailstage_earlydrop_guard_2k_cuda",
  "data": {
    "dataset": "cifar10",
    "root": "/root/autodl-tmp/CoFiTok/datasets",
    "image_size": 32,
    "channels": 3,
    "batch_size": 64,
    "num_workers": 2,
    "class_conditional": false
  },
  "model": {
    "image_channels": 3,
    "image_size": 32,
    "token_count": 8,
    "token_channels": 16,
    "base_channels": 48,
    "predictor_depth": 3,
    "synthesis_kernel_size": 3,
    "gamma_mode": "learned_scalar",
    "synthesis_active_token_channels": [4, 4, 8, 8, 12, 12, 16, 16]
  },
  "loss": {
    "prefix_weight": 0.03,
    "monotonic_weight": 0.02,
    "tail_early_dropout_weight": 0.25,
    "tail_early_dropout_prob": 0.5,
    "tail_early_dropout_start": 1
  },
  "runtime": {
    "device": "cuda",
    "seed": 37,
    "steps": 2000
  },
  "optimization": {
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "betas": [0.9, 0.999],
    "grad_clip_norm": 1.0,
    "log_interval": 200,
    "visualization_count": 8
  }
}
