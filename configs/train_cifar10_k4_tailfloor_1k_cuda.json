{
  "name": "train_cifar10_k4_tailfloor_1k_cuda",
  "data": {
    "dataset": "cifar10",
    "root": "/root/autodl-tmp/CoFiTok/datasets",
    "image_size": 32,
    "channels": 3,
    "batch_size": 64,
    "num_workers": 2,
    "class_conditional": false
  },
  "model": {
    "image_channels": 3,
    "image_size": 32,
    "token_count": 4,
    "token_channels": 16,
    "base_channels": 48,
    "predictor_depth": 3,
    "synthesis_kernel_size": 3,
    "gamma_mode": "learned_scalar"
  },
  "loss": {
    "epsilon_weight": 1.0,
    "prefix_weight": 0.25,
    "monotonic_weight": 0.05,
    "monotonic_margin": 0.0,
    "zero_token_weight": 0.01,
    "energy_budget_weight": 5.0,
    "energy_target": [0.55, 0.25, 0.13, 0.07],
    "tail_floor_weight": 250.0,
    "tail_floor_min_ratio": 0.02
  },
  "runtime": {
    "device": "cuda",
    "seed": 23,
    "steps": 1000
  },
  "optimization": {
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "betas": [0.9, 0.999],
    "grad_clip_norm": 1.0,
    "log_interval": 100,
    "visualization_count": 8
  }
}
